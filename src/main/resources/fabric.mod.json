{
  "schemaVersion": 1,
  "id": "buildzones",
  "version": "${version}",
  "name": "BuildZones",
  "description": "Desenhe, ajuste e acompanhe volumes de construção no mundo, com substituição de blocos validada pelo servidor.",
  "authors": [],
  "license": "All-Rights-Reserved",
  "icon": "assets/buildzones/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "dev.buildzones.BuildZones"
    ],
    "client": [
      "dev.buildzones.client.BuildZonesClient"
    ]
  },
  "mixins": [
    "buildzones.mixins.json",
    {
      "config": "buildzones.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.14.22",
    "minecraft": "~1.20.1",
    "java": ">=17",
    "fabric-api": "*"
  }
}
